---
interface Property {
  slug: string;
  title: string;
  location: string;
  tag?: string | null;
  price: string;
  operation?: string;
  beds?: number | null;
  baths?: number | null;
  built?: string | null;
  land?: string | null;
  image: string;
}
interface Props {
  property: Property;
  featured?: boolean;
}
const { property, featured = false } = Astro.props;
---

<a
  href={`/propiedades/${property.slug}`}
  class={`group relative flex flex-col overflow-hidden rounded-md border border-stone-200 bg-white transition-all duration-300 hover:-translate-y-1.5 hover:border-gold/40 hover:shadow-[0_20px_50px_rgba(12,26,46,0.18)] ${
    featured ? "md:col-span-2" : ""
  }`}
>
  <div class={`relative overflow-hidden ${featured ? "h-80" : "h-60"}`}>
    <img
      src={property.image}
      alt={property.title}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      loading="lazy"
    />
    <!-- degradado para legibilidad y look editorial -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/70 via-navy-950/0 to-navy-950/10"
    >
    </div>

    <div class="absolute left-4 top-4 flex gap-2">
      {
        property.operation && (
          <span class="rounded-full bg-navy-950/80 px-3 py-1 font-ui text-[10px] font-bold uppercase tracking-wider text-paper backdrop-blur-sm">
            {property.operation}
          </span>
        )
      }
      {
        property.tag && (
          <span class="rounded-full bg-gold px-3 py-1 font-ui text-[10px] font-bold uppercase tracking-wider text-navy-950 shadow-sm">
            {property.tag}
          </span>
        )
      }
    </div>

    <!-- precio superpuesto sobre la imagen: mucho más llamativo -->
    <div class="absolute inset-x-4 bottom-4">
      <p
        class="font-display text-2xl font-bold text-paper drop-shadow-md md:text-3xl"
      >
        {property.price}
      </p>
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div>
      <h3
        class="font-display text-lg font-semibold leading-snug text-navy-900 transition-colors group-hover:text-gold-dark"
      >
        {property.title}
      </h3>
      <p
        class="mt-1 flex items-center gap-1.5 font-body text-sm text-stone-500"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5 shrink-0 text-gold-dark"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
          ></path>
        </svg>
        {property.location}
      </p>
    </div>

    <div
      class="mt-auto flex flex-wrap items-center gap-2 border-t border-stone-100 pt-4"
    >
      {
        property.beds != null && (
          <span class="flex items-center gap-1.5 rounded-full bg-navy-800/5 px-3 py-1.5 font-ui text-xs font-semibold text-navy-800">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 19.5v-15m0 4.5h16.5v10.5M3.75 9h16.5M6 9V6a1.5 1.5 0 011.5-1.5h2A1.5 1.5 0 0111 6v3"
              />
            </svg>
            {property.beds}
          </span>
        )
      }
      {
        property.baths != null && (
          <span class="flex items-center gap-1.5 rounded-full bg-navy-800/5 px-3 py-1.5 font-ui text-xs font-semibold text-navy-800">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 10.5V6.75A2.25 2.25 0 016.75 4.5h.75M3 10.5h18M4.5 10.5v6a3 3 0 003 3h9a3 3 0 003-3v-6"
              />
            </svg>
            {property.baths}
          </span>
        )
      }
      {
        (property.built || property.land) && (
          <span class="flex items-center gap-1.5 rounded-full bg-navy-800/5 px-3 py-1.5 font-ui text-xs font-semibold text-navy-800">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M20.25 3.75v4.5m0-4.5h-4.5m4.5 0L15 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 20.25v-4.5m0 4.5h-4.5m4.5 0L15 15"
              />
            </svg>
            {property.built || property.land}
          </span>
        )
      }
      <span
        class="ml-auto font-ui text-xs font-semibold text-gold-dark opacity-0 transition-opacity group-hover:opacity-100"
      >
        Ver detalle →
      </span>
    </div>
  </div>
</a>
