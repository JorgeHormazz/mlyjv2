---
import { site, telLink, whatsappLink } from '../data/site.js';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: '/', label: 'Inicio', key: 'inicio' },
  { href: '/propiedades', label: 'Propiedades', key: 'propiedades' },
  { href: '/sobre-mi', label: 'Quiénes somos', key: 'sobre-mi' },
  { href: '/contacto', label: 'Contacto', key: 'contacto' },
];
---
<header class="sticky top-0 z-40 w-full border-b border-stone-200 bg-paper/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 md:px-12">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo.png" alt={site.name} class="h-11 w-11 rounded-sm object-contain" />
      <span class="hidden font-display text-lg font-semibold leading-none text-navy-900 sm:block">
        {site.shortName}<br class="hidden lg:block"/> <span class="font-body text-xs font-normal tracking-wide text-stone-600">PROPIEDADES</span>
      </span>
    </a>

    <nav class="hidden items-center gap-9 font-ui text-sm font-medium text-stone-600 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class={`relative py-1 transition-colors hover:text-navy-900 ${
            active === l.key ? 'text-navy-900' : ''
          }`}
        >
          {l.label}
          {active === l.key && (
            <span class="absolute -bottom-[17px] left-0 h-[2px] w-full bg-gold"></span>
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        class="btn-outline hidden md:inline-flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.86.5 3.61 1.44 5.13L2 22l5.05-1.42a9.96 9.96 0 004.97 1.32c5.52 0 10-4.48 10-10S17.54 2 12.02 2zm0 18.06c-1.6 0-3.15-.43-4.5-1.24l-.32-.19-3 .84.83-2.93-.21-.32a8.03 8.03 0 01-1.29-4.32c0-4.46 3.63-8.09 8.09-8.09s8.08 3.63 8.08 8.09-3.62 8.16-8.08 8.16zm4.44-6.03c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.35-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.35 1 2.51c.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28z" />
        </svg>
        WhatsApp
      </a>
      <a href={telLink()} class="btn-primary hidden md:inline-flex">
        Llamar ahora
      </a>
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        aria-label="Escribir por WhatsApp"
        class="flex h-10 w-10 items-center justify-center rounded-sm border border-stone-200 text-navy-800 transition-colors hover:border-navy-800 md:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.86.5 3.61 1.44 5.13L2 22l5.05-1.42a9.96 9.96 0 004.97 1.32c5.52 0 10-4.48 10-10S17.54 2 12.02 2zm0 18.06c-1.6 0-3.15-.43-4.5-1.24l-.32-.19-3 .84.83-2.93-.21-.32a8.03 8.03 0 01-1.29-4.32c0-4.46 3.63-8.09 8.09-8.09s8.08 3.63 8.08 8.09-3.62 8.16-8.08 8.16zm4.44-6.03c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.35-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.35 1 2.51c.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28z" />
        </svg>
      </a>
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-sm border border-stone-200 text-navy-900 md:hidden"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-paper md:hidden">
    <nav class="flex flex-col gap-1 px-5 py-4 font-ui text-base font-medium text-stone-700">
      {links.map((l) => (
        <a
          href={l.href}
          class={`rounded-sm px-3 py-3 transition-colors hover:bg-navy-800/5 ${
            active === l.key ? 'bg-navy-800/5 text-navy-900' : ''
          }`}
        >
          {l.label}
        </a>
      ))}
      <a href={telLink()} class="btn-primary mt-2 w-full">Llamar ahora</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
