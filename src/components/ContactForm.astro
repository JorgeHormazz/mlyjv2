---
import { site } from "../data/site.js";

interface Props {
  compact?: boolean;
  presetSubject?: string;
}
const { compact = false, presetSubject = "" } = Astro.props;

const formAction = `https://formsubmit.co/ajax/${site.email}`;
const submitLabel = compact ? "Solicitar información" : "Enviar mensaje";
---

<form
  id="contact-form"
  class="flex flex-col gap-5"
  method="POST"
  action={formAction}
  name="contacto"
>
  <input
    type="hidden"
    name="_subject"
    value="Nuevo mensaje desde el sitio ML y JV"
  />
  <input type="hidden" name="_captcha" value="false" />
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label class="field-label" for="name">Nombre completo</label>
      <input
        class="field"
        id="name"
        name="name"
        type="text"
        placeholder="Juan Pérez"
        required
      />
    </div>
    <div>
      <label class="field-label" for="phone">Teléfono</label>
      <input
        class="field"
        id="phone"
        name="phone"
        type="tel"
        placeholder="+56 9 1234 5678"
      />
    </div>
  </div>
  <div>
    <label class="field-label" for="email">Correo electrónico</label>
    <input
      class="field"
      id="email"
      name="email"
      type="email"
      placeholder="juan@ejemplo.com"
      required
    />
  </div>
  {
    !compact && (
      <div>
        <label class="field-label" for="subject">
          Asunto
        </label>
        <select class="field" id="subject" name="subject">
          <option selected={presetSubject === "Comprar propiedad"}>
            Comprar propiedad
          </option>
          <option selected={presetSubject === "Arrendar propiedad"}>
            Arrendar propiedad
          </option>
          <option selected={presetSubject === "Asesoría general"}>
            Asesoría general
          </option>
          <option selected={presetSubject === "Vender o arrendar mi propiedad"}>
            Vender o arrendar mi propiedad
          </option>
          <option selected={presetSubject === "Proyecto de inversión"}>
            Proyecto de inversión
          </option>
          <option>Otro</option>
        </select>
      </div>
    )
  }
  <div>
    <label class="field-label" for="message">Mensaje</label>
    <textarea
      class="field resize-none"
      id="message"
      name="message"
      rows={compact ? 3 : 5}
      placeholder={presetSubject
        ? `Hola, me interesa ${presetSubject.toLowerCase()}...`
        : "¿En qué podemos ayudarte?"}
      required></textarea>
  </div>

  <p id="contact-form-error" class="hidden font-body text-sm text-red-600">
    No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos por WhatsApp.
  </p>

  <button type="submit" id="contact-form-submit" class="btn-primary w-full">
    {submitLabel}
  </button>
</form>

<div
  id="contact-form-success"
  class="hidden flex-col items-center gap-3 rounded-sm border border-stone-200 bg-white p-8 text-center"
>
  <span
    class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-800/10 text-navy-800"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.5 12.75l6 6 9-13.5"></path>
    </svg>
  </span>
  <p class="font-display text-lg font-semibold text-navy-900">
    ¡Mensaje enviado!
  </p>
  <p class="font-body text-sm text-stone-600">
    Gracias por escribirnos, te responderemos a la brevedad.
  </p>
</div>

<script define:vars={{ submitLabel }}>
  const form = document.getElementById("contact-form");
  const successBox = document.getElementById("contact-form-success");
  const errorBox = document.getElementById("contact-form-error");
  const submitBtn = document.getElementById("contact-form-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox?.classList.add("hidden");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
    }

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });

      if (!res.ok) throw new Error("Request failed");

      form.classList.add("hidden");
      successBox?.classList.remove("hidden");
      successBox?.classList.add("flex");
    } catch (err) {
      errorBox?.classList.remove("hidden");
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    }
  });
</script>
