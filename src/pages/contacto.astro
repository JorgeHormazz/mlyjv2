---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Coordinates from "../components/Coordinates.astro";
import {
  site,
  telLink,
  mailLink,
  whatsappLink,
  mapsLink,
  mapsEmbedSrc,
} from "../data/site.js";

const contactItems = [
  {
    label: "Central de llamadas",
    value: site.phoneDisplay,
    href: telLink(),
    icon: "M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372a1.5 1.5 0 00-1.086-1.442l-4.02-1.148a1.5 1.5 0 00-1.588.44l-.723.88a11.24 11.24 0 01-5.62-5.62l.88-.723a1.5 1.5 0 00.44-1.588L8.164 3.336A1.5 1.5 0 006.722 2.25H5.25A2.25 2.25 0 003 4.5v2.25z",
  },
  {
    label: "Email",
    value: site.email,
    href: mailLink(),
    icon: "M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.01 1.877l-7.5 5.006a2.25 2.25 0 01-2.48 0L3.26 8.87a2.25 2.25 0 01-1.01-1.877V6.75",
  },
  {
    label: "Horario de atención",
    value: `${site.hours[0].days} ${site.hours[0].time} · ${site.hours[1].days} ${site.hours[1].time}`,
    href: undefined,
    icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    label: "Zona de cobertura",
    value: site.coverageArea,
    href: mapsLink(),
    icon: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
  },
];
---

<Layout
  title="Contacto"
  active="contacto"
  description="Escríbenos, llama o contáctanos por WhatsApp. Corretaje e inversiones inmobiliarias en Chillán y toda la Región de Ñuble."
>
  <section class="mx-auto max-w-7xl px-5 py-16 text-center md:px-12">
    <Coordinates class="mb-4 justify-center" label="CONTACTO" />
    <h1 class="font-display text-4xl font-semibold text-navy-900 md:text-5xl">
      Hablemos
    </h1>
    <p class="mx-auto mt-4 max-w-xl font-body text-stone-600">
      Estamos aquí para asesorarte de manera personalizada en tu próxima
      inversión inmobiliaria, en Chillán, la Región de Ñuble o donde te
      encuentres.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-gold"
        >Escribir por WhatsApp</a
      >
      <a href={telLink()} class="btn-outline">Llamar ahora</a>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-5 pb-24 md:grid-cols-12 md:px-12"
  >
    <div
      class="rounded-sm border border-stone-200 bg-white p-6 shadow-card md:col-span-7 md:p-10"
    >
      <h2 class="mb-6 font-display text-2xl font-semibold text-navy-900">
        Envíanos un mensaje
      </h2>
      <ContactForm />
    </div>

    <div class="flex flex-col gap-8 md:col-span-5">
      <div
        class="rounded-sm border border-stone-200 bg-white p-6 shadow-card md:p-8"
      >
        <h3 class="mb-6 font-display text-xl font-semibold text-navy-900">
          Información directa
        </h3>
        <div class="flex flex-col gap-5">
          {
            contactItems.map((item, i) => (
              <>
                <div class="flex items-start gap-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-800/5 text-navy-800">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.75"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d={item.icon}
                      />
                    </svg>
                  </span>
                  <div>
                    <p class="font-ui text-[11px] font-semibold uppercase tracking-widest2 text-stone-500">
                      {item.label}
                    </p>
                    {item.href ? (
                      <a
                        href={item.href}
                        target={
                          item.href.startsWith("http") ? "_blank" : undefined
                        }
                        rel={
                          item.href.startsWith("http") ? "noopener" : undefined
                        }
                        class="font-body text-navy-900 transition-colors hover:text-gold-dark"
                      >
                        {item.value}
                      </a>
                    ) : (
                      <p class="font-body text-navy-900">{item.value}</p>
                    )}
                  </div>
                </div>
                {i < contactItems.length - 1 && (
                  <div class="h-px w-full bg-stone-100" />
                )}
              </>
            ))
          }
        </div>

        <div
          class="mt-6 flex flex-col gap-2 border-t border-stone-100 pt-5 font-body text-sm text-stone-600"
        >
          {
            site.whatsappNumbers.map((w) => (
              <a
                href={whatsappLink(w.e164)}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 transition-colors hover:text-gold-dark"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.86.5 3.61 1.44 5.13L2 22l5.05-1.42a9.96 9.96 0 004.97 1.32c5.52 0 10-4.48 10-10S17.54 2 12.02 2zm0 18.06c-1.6 0-3.15-.43-4.5-1.24l-.32-.19-3 .84.83-2.93-.21-.32a8.03 8.03 0 01-1.29-4.32c0-4.46 3.63-8.09 8.09-8.09s8.08 3.63 8.08 8.09-3.62 8.16-8.08 8.16zm4.44-6.03c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.35-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.35 1 2.51c.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28z" />
                </svg>
                {w.display}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={mapsLink()}
        target="_blank"
        rel="noopener"
        class="group relative block h-64 overflow-hidden rounded-sm border border-stone-200 shadow-card"
      >
        <iframe
          title={`Mapa de ${site.coverageArea}`}
          class="h-full w-full grayscale pointer-events-none"
          src={mapsEmbedSrc()}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div
          class="pointer-events-none absolute inset-x-4 bottom-4 rounded-sm bg-white/90 px-4 py-2 text-center font-ui text-xs font-semibold text-navy-900 shadow-sm transition-colors group-hover:bg-white"
        >
          Abrir en Google Maps · {site.coverageArea}
        </div>
      </a>
    </div>
  </section>
</Layout>
