---
import Layout from "../../layouts/Layout.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import { getAllProperties, getPropertyBySlug } from "../../lib/properties.js";
import {
  site,
  telLink,
  whatsappLink,
  propertyWhatsappMessage,
  mailLink,
} from "../../data/site.js";

export const prerender = false;

const { slug } = Astro.params;
const property = await getPropertyBySlug(slug);

if (!property) {
  return Astro.redirect("/propiedades");
}

const allProperties = await getAllProperties();
const related = allProperties
  .filter((p: any) => p.slug !== property.slug)
  .slice(0, 3);

// Solo se arma con los datos que la propiedad realmente tiene
const stats: [string, string | number][] = [
  property.beds != null ? ["Habitaciones", property.beds] : null,
  property.baths != null ? ["Baños", property.baths] : null,
  property.built ? ["Construidos", property.built] : null,
  property.land ? ["Terreno", property.land] : null,
].filter((s): s is [string, string | number] => s !== null);
---

<Layout
  title={property.title}
  active="propiedades"
  description={property.description?.[0] ?? property.title}
>
  <nav
    class="mx-auto max-w-7xl px-5 pt-8 font-ui text-[11px] uppercase tracking-wide text-stone-400 md:px-12"
  >
    <a href="/" class="hover:text-navy-800">Inicio</a>
    <span class="mx-2">/</span>
    <a href="/propiedades" class="hover:text-navy-800">Propiedades</a>
    <span class="mx-2">/</span>
    <span class="text-navy-900">{property.title}</span>
  </nav>

  <section class="mx-auto max-w-7xl px-5 py-6 md:px-12">
    <div
      class="grid grid-cols-1 gap-3 md:grid-cols-4 md:grid-rows-2"
      id="gallery"
    >
      <button
        type="button"
        class="lightbox-trigger group relative h-72 overflow-hidden rounded-sm md:col-span-2 md:row-span-2 md:h-full"
        data-index="0"
      >
        <img
          src={property.image}
          alt={property.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/50 via-transparent to-transparent"
        >
        </div>
        <span
          class="absolute left-4 top-4 rounded-sm bg-gold px-3 py-1 font-ui text-[11px] font-bold uppercase tracking-wider text-navy-950 shadow-sm"
        >
          {property.operation}
        </span>
      </button>
      {
        (property.gallery ?? []).slice(0, 4).map((img: string, i: number) => {
          const totalImages = 1 + (property.gallery ?? []).length;
          const isLastVisible = i === 3;
          const remaining = totalImages - 5; // 1 principal + 4 mostradas
          const showMoreOverlay = isLastVisible && remaining > 0;
          return (
            <button
              type="button"
              class="lightbox-trigger group relative hidden h-40 overflow-hidden rounded-sm md:block"
              data-index={i + 1}
            >
              <img
                src={img}
                alt={property.title}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
              {showMoreOverlay && (
                <div class="pointer-events-none absolute inset-0 flex items-center justify-center bg-navy-950/70 backdrop-blur-[1px]">
                  <span class="font-ui text-lg font-bold text-paper">
                    +{remaining} fotos
                  </span>
                </div>
              )}
            </button>
          );
        })
      }
    </div>
    <button
      type="button"
      id="see-all-photos"
      class="mt-3 flex items-center gap-2 font-ui text-sm font-semibold text-navy-800 hover:text-gold-dark md:hidden"
    >
      Ver todas las fotos ({1 + (property.gallery ?? []).length})
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
      </svg>
    </button>
  </section>

  <div
    id="lightbox"
    class="fixed inset-0 z-[60] hidden flex-col items-center justify-center bg-navy-950/95 p-4 md:p-8"
  >
    <button
      id="lightbox-close"
      aria-label="Cerrar"
      class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full bg-paper/10 text-paper transition-colors hover:bg-paper/20"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div
      class="relative flex w-full max-w-6xl flex-1 items-center justify-center"
    >
      <button
        id="lightbox-prev"
        aria-label="Anterior"
        class="absolute left-0 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-paper/10 text-paper transition-colors hover:bg-paper/20 md:-left-4"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5L8.25 12l7.5-7.5"></path>
        </svg>
      </button>

      <img
        id="lightbox-image"
        src=""
        alt={property.title}
        class="max-h-[75vh] w-full max-w-5xl rounded-sm object-contain shadow-cardLg"
      />

      <button
        id="lightbox-next"
        aria-label="Siguiente"
        class="absolute right-0 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-paper/10 text-paper transition-colors hover:bg-paper/20 md:-right-4"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
        </svg>
      </button>
    </div>

    <p id="lightbox-count" class="mt-3 font-ui text-xs text-paper/70"></p>

    <div
      id="lightbox-thumbs"
      class="mt-3 flex w-full max-w-4xl gap-2 overflow-x-auto px-2 pb-1"
    >
    </div>
  </div>

  <section
    class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-5 pb-24 md:grid-cols-3 md:px-12"
  >
    <div class="flex flex-col gap-10 md:col-span-2">
      <div class="border-b border-stone-200 pb-8">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="eyebrow"
            >{property.property_type} · {property.commune}</span
          >
        </div>
        <h1
          class="font-display text-3xl font-semibold leading-tight text-navy-900 md:text-4xl"
        >
          {property.title}
        </h1>
        <p class="mt-3 flex items-center gap-1.5 font-body text-stone-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 text-gold-dark"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
            ></path></svg
          >
          {property.location}
        </p>
        <div class="mt-6 flex flex-wrap items-end gap-3">
          <p
            class="font-ui text-4xl font-extrabold tracking-tight text-gold-dark md:text-[42px]"
          >
            {property.price}
          </p>
          <span
            class="rounded-full bg-navy-950 px-3 py-1 font-ui text-[10px] font-bold uppercase tracking-wider text-paper"
          >
            {property.operation}
          </span>
        </div>
        {
          property.price_clp && (
            <p class="mt-1 font-body text-sm text-stone-500">
              {property.price_clp}
            </p>
          )
        }
      </div>

      {
        stats.length > 0 && (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
            {stats.map(([label, value]: [string, string | number]) => (
              <div class="flex flex-col items-center gap-2 rounded-md border border-stone-200 border-t-[3px] border-t-gold bg-stone-50 px-3 py-6 text-center transition-colors hover:bg-white hover:shadow-card">
                <span class="font-ui text-2xl font-extrabold leading-none tracking-tight text-navy-900 sm:text-[26px]">
                  {value}
                </span>
                <span class="font-ui text-[10px] font-semibold uppercase leading-none tracking-widest2 text-stone-500">
                  {label}
                </span>
              </div>
            ))}
          </div>
        )
      }

      {
        property.description?.length > 0 && (
          <div>
            <h2 class="mb-4 font-display text-2xl font-semibold text-navy-900">
              Descripción
            </h2>
            <div class="flex flex-col gap-5 font-body text-[15px] leading-relaxed text-stone-700">
              {property.description.map((p: string) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        )
      }

      {
        property.specs?.length > 0 && (
          <div class="border-t border-stone-200 pt-8">
            <h2 class="mb-4 font-display text-2xl font-semibold text-navy-900">
              Características técnicas
            </h2>
            <ul class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
              {property.specs.map(([label, value]: [string, string]) => (
                <li class="flex justify-between border-b border-stone-100 pb-3 font-body text-sm">
                  <span class="text-stone-500">{label}</span>
                  <span class="font-medium text-navy-900">{value}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <aside class="md:col-span-1">
      <div
        class="sticky top-24 flex flex-col gap-6 overflow-hidden rounded-md border border-stone-200 bg-white shadow-cardLg"
      >
        <div class="flex items-center gap-4 bg-navy-950 px-6 py-5">
          <img
            src="/logo.png"
            alt={site.name}
            class="h-12 w-12 rounded-sm object-contain"
          />
          <div>
            <p class="font-display text-base font-semibold text-paper">
              {site.shortName}
            </p>
            <p
              class="font-ui text-[11px] uppercase tracking-widest2 text-gold-light"
            >
              Asesoría personalizada
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-3 px-6">
          <a href={telLink()} class="btn-primary w-full">Llamar ahora</a>

          <a
            href={whatsappLink(
              undefined,
              propertyWhatsappMessage(property.title),
            )}
            target="_blank"
            rel="noopener"
            class="btn-outline w-full"
          >
            Contactar por WhatsApp
          </a>
        </div>

        <div class="border-t border-stone-100 px-6 pb-6 pt-5">
          <p class="field-label !mb-3">Solicitar información</p>

          <a
            href={mailLink(`Consulta por ${property.title}`)}
            class="group flex items-center gap-3 rounded-sm border border-stone-200 px-4
        py-3.5 font-body text-sm text-navy-900 transition-colors hover:border-gold
        hover:bg-gold/5"
          >
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy-800/5 text-navy-800 transition-colors group-hover:bg-gold group-hover:text-navy-950"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.01 1.877l-7.5 5.006a2.25 2.25 0 01-2.48 0L3.26 8.87a2.25 2.25 0 01-1.01-1.877V6.75"
                ></path>
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="font-medium">Escríbenos por correo</span>
              <span class="text-xs text-stone-500 break-all">{site.email}</span>
            </span>
          </a>
        </div>
      </div>
    </aside>
  </section>
  <section class="border-t border-stone-200 bg-stone-50 py-20">
    <div class="mx-auto max-w-7xl px-5 md:px-12">
      <h2
        class="mb-8 font-display text-2xl font-semibold text-navy-900 md:text-3xl"
      >
        Otras propiedades que podrían interesarte
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p: any) => <PropertyCard property={p} />)}
      </div>
    </div>
  </section>

  <script
    define:vars={{ images: [property.image, ...(property.gallery ?? [])] }}
  >
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightbox-image");
    const lightboxCount = document.getElementById("lightbox-count");
    const lightboxThumbs = document.getElementById("lightbox-thumbs");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const seeAllBtn = document.getElementById("see-all-photos");
    let current = 0;

    // Construir tiras de miniaturas una sola vez
    if (lightboxThumbs) {
      lightboxThumbs.innerHTML = images
        .map(
          (src, i) => `
        <button type="button" data-thumb-index="${i}" class="thumb-btn h-16 w-24 shrink-0 overflow-hidden rounded-sm border-2 border-transparent opacity-60 transition-all hover:opacity-100">
          <img src="${src}" alt="" class="h-full w-full object-cover" />
        </button>`,
        )
        .join("");

      lightboxThumbs
        .querySelectorAll(".thumb-btn")
        .forEach((btn) =>
          btn.addEventListener("click", () =>
            open(Number(btn.getAttribute("data-thumb-index"))),
          ),
        );
    }

    function render() {
      lightboxImage.src = images[current];
      lightboxCount.textContent = `${current + 1} / ${images.length}`;
      lightboxThumbs?.querySelectorAll(".thumb-btn").forEach((btn, i) => {
        btn.classList.toggle("border-gold", i === current);
        btn.classList.toggle("opacity-60", i !== current);
        btn.classList.toggle("opacity-100", i === current);
      });
      const activeThumb = lightboxThumbs?.querySelector(
        `[data-thumb-index="${current}"]`,
      );
      activeThumb?.scrollIntoView({ inline: "center", block: "nearest" });
    }
    function open(index) {
      current = index;
      render();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }
    function close() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }
    document.querySelectorAll(".lightbox-trigger").forEach((el) => {
      el.addEventListener("click", () => open(Number(el.dataset.index)));
    });
    seeAllBtn?.addEventListener("click", () => open(0));
    closeBtn?.addEventListener("click", close);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });
    prevBtn?.addEventListener("click", () => {
      current = (current - 1 + images.length) % images.length;
      render();
    });
    nextBtn?.addEventListener("click", () => {
      current = (current + 1) % images.length;
      render();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") prevBtn?.click();
      if (e.key === "ArrowRight") nextBtn?.click();
    });
  </script>
</Layout>
