---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Mis propiedades" active="dashboard">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="eyebrow mb-2">Panel administrador</p>
      <h1 class="font-display text-3xl font-semibold text-navy-900">
        Mis propiedades
      </h1>
      <p class="mt-1 font-body text-sm text-stone-500">
        Aquí puedes ver, editar o eliminar las propiedades publicadas en el
        sitio.
      </p>
    </div>
    <a href="/admin/propiedad/nueva" class="btn-primary">+ Agregar propiedad</a>
  </div>

  <div
    id="admin-guard"
    class="rounded-sm border border-stone-200 bg-white p-8 text-center font-body text-sm text-stone-500"
  >
    Verificando sesión...
  </div>

  <div id="admin-content" class="hidden">
    <div
      id="empty-state"
      class="hidden flex-col items-center gap-3 rounded-sm border border-dashed border-stone-300 bg-white py-16 text-center"
    >
      <span
        class="flex h-14 w-14 items-center justify-center rounded-full bg-navy-800/5 text-navy-800"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"
          ></path>
        </svg>
      </span>
      <p class="font-display text-lg font-semibold text-navy-900">
        Aún no tienes propiedades
      </p>
      <p class="max-w-xs font-body text-sm text-stone-500">
        Publica tu primera propiedad para que empiece a aparecer en el sitio
        web.
      </p>
      <a href="/admin/propiedad/nueva" class="btn-primary mt-2"
        >+ Agregar mi primera propiedad</a
      >
    </div>

    <div
      id="properties-grid"
      class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from "../../lib/supabase.js";

  const guard = document.getElementById("admin-guard") as HTMLElement;
  const content = document.getElementById("admin-content") as HTMLElement;
  const grid = document.getElementById("properties-grid") as HTMLElement;
  const emptyState = document.getElementById("empty-state") as HTMLElement;

  const {
    data: { session },
  } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = "/admin/login";
  } else {
    const { data: profile } = await supabase
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();

    if (!profile || profile.role !== "admin") {
      guard.textContent = "Tu cuenta no tiene permisos de administrador.";
      await supabase.auth.signOut();
    } else {
      guard.classList.add("hidden");
      content.classList.remove("hidden");
      content.classList.add("flex", "flex-col", "gap-6");
      await loadProperties();
    }
  }

  async function loadProperties() {
    const { data, error } = await supabase
      .from("properties")
      .select("*")
      .order("created_at", { ascending: false });

    if (error || !data) {
      grid.innerHTML = `<p class="col-span-full rounded-sm bg-red-50 p-4 text-sm text-red-600">Error cargando propiedades.</p>`;
      return;
    }

    if (data.length === 0) {
      emptyState.classList.remove("hidden");
      emptyState.classList.add("flex");
      return;
    }

    grid.innerHTML = data
      .map(
        (p: any) => `
      <div class="flex flex-col overflow-hidden rounded-sm border border-stone-200 bg-white shadow-card">
        <div class="h-40 w-full overflow-hidden bg-stone-100">
          <img src="${p.image}" alt="${p.title}" class="h-full w-full object-cover" />
        </div>
        <div class="flex flex-1 flex-col gap-2 p-4">
          <p class="font-ui text-[10px] font-semibold uppercase tracking-widest2 text-gold-dark">${p.property_type} · ${p.operation}</p>
          <h3 class="font-display text-base font-semibold leading-snug text-navy-900">${p.title}</h3>
          <p class="font-body text-sm text-stone-500">${p.commune}</p>
          <p class="font-display text-lg font-semibold text-navy-900">${p.price}</p>
          <div class="mt-auto flex gap-2 pt-3">
            <a href="/admin/propiedad/${p.id}" class="flex-1 rounded-sm border border-navy-800/30 py-2 text-center font-ui text-xs font-semibold text-navy-800 hover:bg-navy-800/5">Editar</a>
            <button data-id="${p.id}" class="delete-btn flex-1 rounded-sm border border-red-200 py-2 font-ui text-xs font-semibold text-red-600 hover:bg-red-50">Eliminar</button>
          </div>
        </div>
      </div>
    `,
      )
      .join("");

    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (
          !confirm(
            "¿Eliminar esta propiedad? Esta acción no se puede deshacer.",
          )
        )
          return;
        const id = btn.getAttribute("data-id");
        const { error: delError } = await supabase
          .from("properties")
          .delete()
          .eq("id", id);
        if (delError) {
          alert("No se pudo eliminar: " + delError.message);
          return;
        }
        await loadProperties();
      });
    });
  }
</script>
