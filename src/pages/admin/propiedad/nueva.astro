---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Nueva propiedad" active="nueva">
  <div class="mx-auto max-w-3xl">
    <a
      href="/admin"
      class="mb-4 inline-flex items-center gap-1 font-ui text-xs text-stone-500 hover:text-navy-800"
    >
      ← Volver a mis propiedades
    </a>
    <p class="eyebrow mb-2">Nueva publicación</p>
    <h1 class="mb-1 font-display text-3xl font-semibold text-navy-900">
      Agregar propiedad
    </h1>
    <p class="mb-8 font-body text-sm text-stone-500">
      Completa los datos paso a paso. Puedes dejar en blanco lo que no aplique a
      tu propiedad.
    </p>

    <div
      id="admin-guard"
      class="rounded-sm border border-stone-200 bg-white p-8 text-center font-body text-sm text-stone-500"
    >
      Verificando sesión...
    </div>

    <form id="property-form" class="hidden flex-col gap-8">
      <!-- PASO 1 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-4 font-display text-lg font-semibold text-navy-900">
          1. ¿Qué estás publicando?
        </h2>
        <div class="mb-5">
          <p class="field-label !mb-3">Tipo de propiedad</p>
          <div class="flex flex-wrap gap-2" id="property_type_group">
            <label class="type-option">
              <input type="radio" name="property_type" value="Casa" checked />
              <span>Casa</span>
            </label>
            <label class="type-option">
              <input type="radio" name="property_type" value="Departamento" />
              <span>Departamento</span>
            </label>
            <label class="type-option">
              <input type="radio" name="property_type" value="Condominio" />
              <span>Condominio</span>
            </label>
            <label class="type-option">
              <input type="radio" name="property_type" value="Terreno" />
              <span>Terreno</span>
            </label>
          </div>
        </div>
        <div>
          <p class="field-label !mb-3">¿Es para vender o arrendar?</p>
          <div class="flex flex-wrap gap-2">
            <label class="type-option">
              <input type="radio" name="operation" value="Venta" checked />
              <span>Venta</span>
            </label>
            <label class="type-option">
              <input type="radio" name="operation" value="Arriendo" />
              <span>Arriendo</span>
            </label>
          </div>
        </div>
      </section>

      <!-- PASO 2 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          2. Título y ubicación
        </h2>
        <p class="mb-4 font-body text-sm text-stone-500">
          El título es lo primero que verán los interesados.
        </p>
        <div class="flex flex-col gap-4">
          <div>
            <label class="field-label" for="title"
              >Título de la publicación</label
            >
            <input
              class="field"
              id="title"
              required
              placeholder="Ej: Casa amplia con jardín, Sector Norte"
            />
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="field-label" for="location">Sector o barrio</label>
              <input
                class="field"
                id="location"
                required
                placeholder="Ej: Sector Norte"
              />
            </div>
            <div>
              <label class="field-label" for="commune">Comuna</label>
              <input
                class="field"
                id="commune"
                required
                placeholder="Ej: Chillán"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- PASO 3 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          3. Precio
        </h2>
        <p class="mb-4 font-body text-sm text-stone-500">
          Puedes indicar el precio en UF, pesos o como prefieras.
        </p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="price">Precio a mostrar</label>
            <input
              class="field"
              id="price"
              required
              placeholder="Ej: UF 6.200"
            />
          </div>
          <div>
            <label class="field-label" for="price_clp"
              >Precio referencial en pesos (opcional)</label
            >
            <input
              class="field"
              id="price_clp"
              placeholder="Ej: Aprox. $230.000.000 CLP"
            />
          </div>
        </div>
      </section>

      <!-- PASO 4 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          4. Detalles
        </h2>
        <p id="vivienda-help" class="mb-4 font-body text-sm text-stone-500">
          Deja en blanco lo que no aplique.
        </p>
        <div
          id="vivienda-fields"
          class="mb-4 grid grid-cols-2 gap-4 sm:grid-cols-4"
        >
          <div>
            <label class="field-label" for="beds">Habitaciones</label>
            <input class="field" id="beds" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="baths">Baños</label>
            <input class="field" id="baths" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="parking">Estacionamientos</label>
            <input class="field" id="parking" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="built">Construidos</label>
            <input class="field" id="built" placeholder="Ej: 180 m²" />
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="land">Metros de terreno</label>
            <input class="field" id="land" placeholder="Ej: 450 m²" />
          </div>
          <div>
            <label class="field-label" for="year"
              >Año de construcción (opcional)</label
            >
            <input class="field" id="year" placeholder="Ej: 2018" />
          </div>
        </div>
      </section>

      <!-- PASO 5 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          5. Fotos
        </h2>
        <p class="mb-4 font-body text-sm text-stone-500">
          Sube las fotos directamente desde tu computador o celular.
        </p>
        <div class="flex flex-col gap-4">
          <!-- Foto Principal -->
          <div>
            <label class="field-label" for="image">Foto principal</label>
            <input
              class="field"
              id="image"
              type="file"
              accept="image/*"
              required
            />
            <div
              id="image-preview"
              class="mt-3 hidden h-32 w-full overflow-hidden rounded-sm border border-stone-200"
            >
              <img id="image-preview-img" class="h-full w-full object-cover" />
            </div>
          </div>

          <!-- Galería con Botón Custom + Múltiples selecciones -->
          <!-- Fotos adicionales -->
          <div>
            <label class="field-label" for="gallery"> Fotos adicionales </label>

            <input
              class="hidden"
              id="gallery"
              type="file"
              accept="image/*"
              multiple
            />

            <!-- Botón para agregar imágenes -->
            <button
              type="button"
              id="upload-dropzone"
              class="flex w-full cursor-pointer flex-col items-center justify-center rounded-sm border-2 border-dashed border-stone-300 bg-stone-50 p-6 transition-colors hover:border-navy-800 hover:bg-stone-100"
            >
              <span class="font-ui text-sm font-medium text-stone-700">
                + Agregar fotos
              </span>

              <span class="mt-1 font-body text-xs text-stone-400">
                Puedes seleccionar varias imágenes a la vez o agregarlas una por
                una.
              </span>
            </button>

            <!-- Contador -->
            <div
              id="gallery-count"
              class="mt-3 hidden rounded-sm bg-stone-50 px-3 py-2 font-ui text-xs font-medium text-stone-600"
            >
            </div>

            <!-- Lista de imágenes agregadas -->
            <div
              id="gallery-preview"
              class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4"
            >
            </div>
          </div>
        </div>
      </section>

      <!-- PASO 6 -->
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          6. Descripción
        </h2>
        <p class="mb-4 font-body text-sm text-stone-500">
          Cuenta lo más destacado de la propiedad, en tus palabras.
        </p>
        <div class="flex flex-col gap-4">
          <div>
            <label class="field-label" for="tag"
              >Destacar con una etiqueta (opcional)</label
            >
            <input
              class="field"
              id="tag"
              placeholder="Ej: Destacada, Nuevo, Inversión"
            />
          </div>
          <div>
            <label class="field-label" for="description"
              >Descripción (un párrafo por línea)</label
            >
            <textarea
              class="field resize-none"
              id="description"
              rows="4"
              placeholder="Escribe cada párrafo en una línea distinta"
            ></textarea>
          </div>
          <div>
            <label class="field-label" for="specs"
              >Características técnicas (opcional)</label
            >
            <textarea
              class="field resize-none"
              id="specs"
              rows="3"
              placeholder='Una por línea, con formato "Etiqueta: Valor". Ej: Orientación: Norponiente'
            ></textarea>
          </div>
        </div>
      </section>

      <p
        id="form-error"
        class="hidden rounded-sm bg-red-50 px-4 py-3 font-body text-sm text-red-600"
      >
      </p>
      <button type="submit" id="submit-btn" class="btn-primary w-full"
        >Guardar y publicar</button
      >
    </form>
  </div>
</AdminLayout>

<style>
  .type-option {
    @apply cursor-pointer rounded-sm border border-stone-200 px-4 py-2 font-ui text-sm font-medium text-stone-600 transition-colors;
  }
  .type-option input {
    @apply sr-only;
  }
  .type-option:has(input:checked) {
    @apply border-navy-800 bg-navy-800 text-paper;
  }
</style>

<script>
  import { supabase } from "../../../lib/supabase.js";
  import {
    uploadPropertyImage,
    uploadPropertyImages,
  } from "../../../lib/storage.js";

  const guard = document.getElementById("admin-guard") as HTMLElement;
  const form = document.getElementById("property-form") as HTMLFormElement;
  const viviendaFields = document.getElementById(
    "vivienda-fields",
  ) as HTMLElement;
  const viviendaHelp = document.getElementById("vivienda-help") as HTMLElement;
  const errorEl = document.getElementById("form-error") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const titleInput = document.getElementById("title") as HTMLInputElement;

  const imageInput = document.getElementById("image") as HTMLInputElement;
  const imagePreview = document.getElementById("image-preview") as HTMLElement;
  const imagePreviewImg = document.getElementById(
    "image-preview-img",
  ) as HTMLImageElement;
  const galleryInput = document.getElementById("gallery") as HTMLInputElement;
  const galleryPreview = document.getElementById(
    "gallery-preview",
  ) as HTMLElement;
  const dropzone = document.getElementById("upload-dropzone") as HTMLElement;

  // Manejo de Foto Principal
  imageInput?.addEventListener("change", () => {
    const file = imageInput.files?.[0];
    if (!file) {
      imagePreview.classList.add("hidden");
      return;
    }
    imagePreviewImg.src = URL.createObjectURL(file);
    imagePreview.classList.remove("hidden");
  });

  // ============================================================
  // GALERÍA DE FOTOS ADICIONALES
  // ============================================================

  let galleryFiles: File[] = [];

  const galleryCount = document.getElementById("gallery-count") as HTMLElement;

  // Abrir selector de archivos
  dropzone?.addEventListener("click", (event) => {
    event.preventDefault();
    galleryInput?.click();
  });

  // Cuando el usuario selecciona imágenes
  galleryInput?.addEventListener("change", () => {
    if (!galleryInput.files || galleryInput.files.length === 0) {
      return;
    }

    // Convertimos FileList a array
    const selectedFiles = Array.from(galleryInput.files);

    // Agregamos las nuevas imágenes a las que ya existen
    galleryFiles.push(...selectedFiles);

    // Actualizamos la interfaz
    renderGalleryPreview();

    // Limpiamos el input.
    // Esto permite volver a seleccionar el mismo archivo.
    galleryInput.value = "";
  });

  function renderGalleryPreview() {
    galleryPreview.innerHTML = "";

    // Actualizar contador
    if (galleryFiles.length === 0) {
      galleryCount.classList.add("hidden");
      galleryCount.textContent = "";
      return;
    }

    galleryCount.classList.remove("hidden");

    galleryCount.textContent =
      galleryFiles.length === 1
        ? "1 foto adicional seleccionada"
        : `${galleryFiles.length} fotos adicionales seleccionadas`;

    // Crear una tarjeta por cada imagen
    galleryFiles.forEach((file, index) => {
      const container = document.createElement("div");

      container.className =
        "relative overflow-hidden rounded-sm border border-stone-200 bg-white";

      // --------------------------------------------------------
      // PREVISUALIZACIÓN
      // --------------------------------------------------------

      const imageContainer = document.createElement("div");

      imageContainer.className = "relative h-32 w-full";

      const img = document.createElement("img");

      img.src = URL.createObjectURL(file);
      img.alt = file.name;

      img.className = "h-full w-full object-cover";

      imageContainer.appendChild(img);

      // --------------------------------------------------------
      // NÚMERO DE IMAGEN
      // --------------------------------------------------------

      const number = document.createElement("span");

      number.className =
        "absolute left-2 top-2 flex h-6 w-6 items-center justify-center rounded-full bg-white/90 text-xs font-bold text-navy-900 shadow";

      number.textContent = String(index + 1);

      imageContainer.appendChild(number);

      // --------------------------------------------------------
      // BOTÓN ELIMINAR
      // --------------------------------------------------------

      const removeBtn = document.createElement("button");

      removeBtn.type = "button";
      removeBtn.textContent = "×";
      removeBtn.title = "Eliminar esta foto";

      removeBtn.className =
        "absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full bg-red-600 text-lg font-bold leading-none text-white shadow hover:bg-red-700";

      removeBtn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        // Eliminar la imagen del array
        galleryFiles.splice(index, 1);

        // Volver a dibujar
        renderGalleryPreview();
      });

      imageContainer.appendChild(removeBtn);

      // --------------------------------------------------------
      // NOMBRE DEL ARCHIVO
      // --------------------------------------------------------

      const fileInfo = document.createElement("div");

      fileInfo.className = "border-t border-stone-200 px-2 py-2";

      const fileName = document.createElement("p");

      fileName.className = "truncate font-body text-xs text-stone-600";

      fileName.title = file.name;

      fileName.textContent = file.name;

      fileInfo.appendChild(fileName);

      // --------------------------------------------------------
      // AGREGAR TODO
      // --------------------------------------------------------

      container.appendChild(imageContainer);
      container.appendChild(fileInfo);

      galleryPreview.appendChild(container);
    });
  }

  // Verificación de sesión Supabase
  const {
    data: { session },
  } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = "/admin/login";
  } else {
    const { data: profile } = await supabase
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();
    if (!profile || profile.role !== "admin") {
      guard.textContent = "Tu cuenta no tiene permisos de administrador.";
    } else {
      guard.classList.add("hidden");
      form.classList.remove("hidden");
      form.classList.add("flex");
    }
  }

  function slugify(value: string): string {
    return value
      .toString()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  }

  function getTypeSelectValue(): string {
    return (
      (
        document.querySelector(
          'input[name="property_type"]:checked',
        ) as HTMLInputElement
      )?.value ?? "Casa"
    );
  }

  function getOperationValue(): string {
    return (
      (
        document.querySelector(
          'input[name="operation"]:checked',
        ) as HTMLInputElement
      )?.value ?? "Venta"
    );
  }

  function toggleViviendaFields() {
    const isTerreno = getTypeSelectValue() === "Terreno";
    viviendaFields.style.display = isTerreno ? "none" : "grid";
    viviendaHelp.textContent = isTerreno
      ? "Los terrenos no requieren habitaciones ni baños."
      : "Deja en blanco lo que no aplique.";
  }

  document
    .querySelectorAll('input[name="property_type"]')
    .forEach((el) => el.addEventListener("change", toggleViviendaFields));
  toggleViviendaFields();

  function linesToArray(value: string): string[] {
    return value
      .split("\n")
      .map((l) => l.trim())
      .filter(Boolean);
  }

  function specsToArray(value: string): [string, string][] {
    return linesToArray(value).map((line): [string, string] => {
      const idx = line.indexOf(":");
      return idx === -1
        ? [line, ""]
        : [line.slice(0, idx).trim(), line.slice(idx + 1).trim()];
    });
  }

  function toIntOrNull(value: string): number | null {
    return value === "" ? null : parseInt(value, 10);
  }

  function getInput(id: string): HTMLInputElement | HTMLTextAreaElement {
    return document.getElementById(id) as
      HTMLInputElement | HTMLTextAreaElement;
  }

  // Submit del Formulario
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    submitBtn.disabled = true;

    const mainFile = imageInput.files?.[0];
    if (!mainFile) {
      errorEl.textContent = "Debes subir una foto principal.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      return;
    }

    const isTerreno = getTypeSelectValue() === "Terreno";
    const val = (id: string) => getInput(id).value.trim();
    const baseSlug = slugify(titleInput.value) || "propiedad";
    const finalSlug = `${baseSlug}-${Date.now().toString(36).slice(-4)}`;

    try {
      submitBtn.textContent = "Subiendo fotos...";
      const { url: mainImageUrl } = await uploadPropertyImage(
        mainFile,
        finalSlug,
      );

      // Subida masiva leyendo el arreglo acumulado galleryFiles
      let galleryUrls: string[] = [];

      if (galleryFiles.length > 0) {
        const uploaded = await uploadPropertyImages(galleryFiles, finalSlug);

        galleryUrls = uploaded.map((u) => u.url);
      }

      submitBtn.textContent = "Guardando...";

      const payload = {
        slug: finalSlug,
        title: val("title"),
        property_type: getTypeSelectValue(),
        operation: getOperationValue(),
        tag: val("tag") || null,
        location: val("location"),
        commune: val("commune"),
        price: val("price"),
        price_clp: val("price_clp") || null,
        beds: isTerreno ? null : toIntOrNull(val("beds")),
        baths: isTerreno ? null : toIntOrNull(val("baths")),
        parking: isTerreno ? null : toIntOrNull(val("parking")),
        built: isTerreno ? null : val("built") || null,
        land: val("land") || null,
        year: val("year") || null,

        image: mainImageUrl,

        // SOLO las imágenes que quedaron en la vista previa
        gallery: galleryUrls,

        description: linesToArray(getInput("description").value),
        specs: specsToArray(getInput("specs").value),
      };

      const { error } = await supabase.from("properties").insert(payload);
      if (error) {
        errorEl.textContent = "No se pudo guardar: " + error.message;
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Guardar y publicar";
        return;
      }
      window.location.href = "/admin";
    } catch (err: any) {
      errorEl.textContent =
        "Error subiendo fotos: " + (err?.message ?? "intenta de nuevo");
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Guardar y publicar";
    }
  });
</script>
