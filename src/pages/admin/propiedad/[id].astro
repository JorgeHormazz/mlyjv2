---
import AdminLayout from "../../../layouts/AdminLayout.astro";
const { id } = Astro.params;
---

<AdminLayout title="Editar propiedad" active="dashboard">
  <div class="mx-auto max-w-3xl" id="edit-root" data-property-id={id}>
    <a
      href="/admin"
      class="mb-4 inline-flex items-center gap-1 font-ui text-xs text-stone-500 hover:text-navy-800"
    >
      ← Volver a mis propiedades
    </a>
    <p class="eyebrow mb-2">Editar publicación</p>
    <h1 class="mb-8 font-display text-3xl font-semibold text-navy-900">
      Editar propiedad
    </h1>

    <div
      id="admin-guard"
      class="rounded-sm border border-stone-200 bg-white p-8 text-center font-body text-sm text-stone-500"
    >
      Verificando sesión...
    </div>

    <form id="property-form" class="hidden flex-col gap-8">
      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-4 font-display text-lg font-semibold text-navy-900">
          1. ¿Qué estás publicando?
        </h2>
        <div class="mb-5">
          <p class="field-label !mb-3">Tipo de propiedad</p>
          <div class="flex flex-wrap gap-2">
            <label class="type-option"
              ><input type="radio" name="property_type" value="Casa" /><span
                >Casa</span
              ></label
            >
            <label class="type-option"
              ><input
                type="radio"
                name="property_type"
                value="Departamento"
              /><span>Departamento</span></label
            >
            <label class="type-option"
              ><input
                type="radio"
                name="property_type"
                value="Condominio"
              /><span>Condominio</span></label
            >
            <label class="type-option"
              ><input type="radio" name="property_type" value="Terreno" /><span
                >Terreno</span
              ></label
            >
          </div>
        </div>
        <div>
          <p class="field-label !mb-3">¿Es para vender o arrendar?</p>
          <div class="flex flex-wrap gap-2">
            <label class="type-option"
              ><input type="radio" name="operation" value="Venta" /><span
                >Venta</span
              ></label
            >
            <label class="type-option"
              ><input type="radio" name="operation" value="Arriendo" /><span
                >Arriendo</span
              ></label
            >
          </div>
        </div>
      </section>

      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          2. Título y ubicación
        </h2>
        <p class="mb-4 font-body text-sm text-stone-500">
          Cambiar el título no cambia la dirección web de la propiedad.
        </p>
        <div class="flex flex-col gap-4">
          <div>
            <label class="field-label" for="title"
              >Título de la publicación</label
            >
            <input class="field" id="title" required />
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="field-label" for="location">Sector o barrio</label>
              <input class="field" id="location" required />
            </div>
            <div>
              <label class="field-label" for="commune">Comuna</label>
              <input class="field" id="commune" required list="commune-list" />
              <datalist id="commune-list">
                <option value="Chillán"></option>
                <option value="Chillán Viejo"></option>
                <option value="San Carlos"></option>
                <option value="Bulnes"></option>
              </datalist>
            </div>
          </div>
        </div>
      </section>

      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          3. Precio
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="price">Precio a mostrar</label>
            <input class="field" id="price" required />
          </div>
          <div>
            <label class="field-label" for="price_clp"
              >Precio referencial en pesos (opcional)</label
            >
            <input class="field" id="price_clp" />
          </div>
        </div>
      </section>

      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          4. Detalles
        </h2>
        <p id="vivienda-help" class="mb-4 font-body text-sm text-stone-500">
          Deja en blanco lo que no aplique.
        </p>
        <div
          id="vivienda-fields"
          class="mb-4 grid grid-cols-2 gap-4 sm:grid-cols-4"
        >
          <div>
            <label class="field-label" for="beds">Habitaciones</label><input
              class="field"
              id="beds"
              type="number"
              min="0"
            />
          </div>
          <div>
            <label class="field-label" for="baths">Baños</label><input
              class="field"
              id="baths"
              type="number"
              min="0"
            />
          </div>
          <div>
            <label class="field-label" for="parking">Estacionamientos</label
            ><input class="field" id="parking" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="built">Construidos</label><input
              class="field"
              id="built"
              placeholder="Ej: 180 m²"
            />
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="land">Metros de terreno</label
            ><input class="field" id="land" placeholder="Ej: 450 m²" />
          </div>
          <div>
            <label class="field-label" for="year"
              >Año de construcción (opcional)</label
            ><input class="field" id="year" />
          </div>
        </div>
      </section>

      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          5. Fotos
        </h2>
        <div class="flex flex-col gap-4">
          <div>
            <label class="field-label" for="image">Foto principal (link)</label>
            <input class="field" id="image" type="url" required />
          </div>
          <div>
            <label class="field-label" for="gallery"
              >Fotos adicionales (un link por línea)</label
            >
            <textarea class="field resize-none" id="gallery" rows="3"
            ></textarea>
          </div>
        </div>
      </section>

      <section class="rounded-sm border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-display text-lg font-semibold text-navy-900">
          6. Descripción
        </h2>
        <div class="flex flex-col gap-4">
          <div>
            <label class="field-label" for="tag"
              >Destacar con una etiqueta (opcional)</label
            >
            <input
              class="field"
              id="tag"
              placeholder="Ej: Destacada, Nuevo, Inversión"
            />
          </div>
          <div>
            <label class="field-label" for="description"
              >Descripción (un párrafo por línea)</label
            >
            <textarea class="field resize-none" id="description" rows="4"
            ></textarea>
          </div>
          <div>
            <label class="field-label" for="specs"
              >Características técnicas (opcional)</label
            >
            <textarea class="field resize-none" id="specs" rows="3"></textarea>
          </div>
        </div>
      </section>

      <p
        id="form-error"
        class="hidden rounded-sm bg-red-50 px-4 py-3 font-body text-sm text-red-600"
      >
      </p>
      <div class="flex gap-3">
        <button type="submit" id="submit-btn" class="btn-primary flex-1"
          >Guardar cambios</button
        >
        <button
          type="button"
          id="delete-btn"
          class="rounded-sm border border-red-200 px-6 py-3.5 font-ui text-sm font-semibold text-red-600 hover:bg-red-50"
          >Eliminar</button
        >
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .type-option {
    @apply cursor-pointer rounded-sm border border-stone-200 px-4 py-2 font-ui text-sm font-medium text-stone-600 transition-colors;
  }
  .type-option input {
    @apply sr-only;
  }
  .type-option:has(input:checked) {
    @apply border-navy-800 bg-navy-800 text-paper;
  }
</style>

<script>
  import { supabase } from "../../../lib/supabase.js";

  // Declarar explícitamente las interfaces de la propiedad si es necesario
  interface Property {
    title: string;
    property_type: string;
    operation: string;
    tag?: string | null;
    location: string;
    commune: string;
    price: string;
    price_clp?: string | null;
    beds?: number | null;
    baths?: number | null;
    parking?: number | null;
    built?: string | null;
    land?: string | null;
    year?: string | null;
    image: string;
    gallery?: string[];
    description?: string[];
    specs?: [string, string][];
  }

  // Hacer castings explícitos de los elementos del DOM
  const guard = document.getElementById("admin-guard") as HTMLDivElement;
  const form = document.getElementById("property-form") as HTMLFormElement;
  const viviendaFields = document.getElementById(
    "vivienda-fields",
  ) as HTMLDivElement;
  const viviendaHelp = document.getElementById(
    "vivienda-help",
  ) as HTMLParagraphElement;
  const errorEl = document.getElementById("form-error") as HTMLParagraphElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const deleteBtn = document.getElementById("delete-btn") as HTMLButtonElement;
  const propertyId =
    document.getElementById("edit-root")?.dataset.propertyId ?? "";

  const {
    data: { session },
  } = await supabase.auth.getSession();

  try {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = "/admin/login";
    } else {
      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", session.user.id)
        .single();

      if (profileError || !profile || profile.role !== "admin") {
        guard.textContent = "Tu cuenta no tiene permisos de administrador.";
      } else {
        const { data: property, error } = await supabase
          .from("properties")
          .select("*")
          .eq("id", propertyId)
          .single();
        if (error || !property) {
          guard.textContent = "Propiedad no encontrada.";
        } else {
          guard.classList.add("hidden");
          form.classList.remove("hidden");
          form.classList.add("flex");
          fillForm(property);
        }
      }
    }
  } catch (err) {
    guard.textContent =
      "Ocurrió un error verificando tu sesión. Recarga la página.";
    console.error(err);
  }

  function setRadioValue(name: string, value: string) {
    const el = document.querySelector<HTMLInputElement>(
      `input[name="${name}"][value="${value}"]`,
    );
    if (el) el.checked = true;
  }

  function getTypeSelectValue(): string {
    return (
      document.querySelector<HTMLInputElement>(
        'input[name="property_type"]:checked',
      )?.value ?? "Casa"
    );
  }

  function getOperationValue(): string {
    return (
      document.querySelector<HTMLInputElement>(
        'input[name="operation"]:checked',
      )?.value ?? "Venta"
    );
  }

  function fillForm(p: Property) {
    (document.getElementById("title") as HTMLInputElement).value = p.title;
    setRadioValue("property_type", p.property_type);
    setRadioValue("operation", p.operation);
    (document.getElementById("tag") as HTMLInputElement).value = p.tag ?? "";
    (document.getElementById("location") as HTMLInputElement).value =
      p.location;
    (document.getElementById("commune") as HTMLInputElement).value = p.commune;
    (document.getElementById("price") as HTMLInputElement).value = p.price;
    (document.getElementById("price_clp") as HTMLInputElement).value =
      p.price_clp ?? "";
    (document.getElementById("beds") as HTMLInputElement).value =
      p.beds?.toString() ?? "";
    (document.getElementById("baths") as HTMLInputElement).value =
      p.baths?.toString() ?? "";
    (document.getElementById("parking") as HTMLInputElement).value =
      p.parking?.toString() ?? "";
    (document.getElementById("built") as HTMLInputElement).value =
      p.built ?? "";
    (document.getElementById("land") as HTMLInputElement).value = p.land ?? "";
    (document.getElementById("year") as HTMLInputElement).value = p.year ?? "";
    (document.getElementById("image") as HTMLInputElement).value = p.image;
    (document.getElementById("gallery") as HTMLTextAreaElement).value = (
      p.gallery ?? []
    ).join("\n");
    (document.getElementById("description") as HTMLTextAreaElement).value = (
      p.description ?? []
    ).join("\n");
    (document.getElementById("specs") as HTMLTextAreaElement).value = (
      p.specs ?? []
    )
      .map(([l, v]) => `${l}: ${v}`)
      .join("\n");
    toggleViviendaFields();
  }

  function toggleViviendaFields() {
    const isTerreno = getTypeSelectValue() === "Terreno";
    if (viviendaFields) {
      viviendaFields.style.display = isTerreno ? "none" : "grid";
    }
    if (viviendaHelp) {
      viviendaHelp.textContent = isTerreno
        ? "Los terrenos no requieren habitaciones ni baños."
        : "Deja en blanco lo que no aplique.";
    }
  }

  document
    .querySelectorAll<HTMLInputElement>('input[name="property_type"]')
    .forEach((el) => el.addEventListener("change", toggleViviendaFields));

  function linesToArray(value: string): string[] {
    return value
      .split("\n")
      .map((l) => l.trim())
      .filter(Boolean);
  }

  function specsToArray(value: string): [string, string][] {
    return linesToArray(value).map((line) => {
      const idx = line.indexOf(":");
      return idx === -1
        ? [line, ""]
        : [line.slice(0, idx).trim(), line.slice(idx + 1).trim()];
    });
  }

  function toIntOrNull(value: string): number | null {
    return value === "" ? null : parseInt(value, 10);
  }

  form?.addEventListener("submit", async (e: SubmitEvent) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Guardando...";
    }

    const isTerreno = getTypeSelectValue() === "Terreno";
    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement)?.value.trim() ?? "";

    const payload = {
      title: val("title"),
      property_type: getTypeSelectValue(),
      operation: getOperationValue(),
      tag: val("tag") || null,
      location: val("location"),
      commune: val("commune"),
      price: val("price"),
      price_clp: val("price_clp") || null,
      beds: isTerreno ? null : toIntOrNull(val("beds")),
      baths: isTerreno ? null : toIntOrNull(val("baths")),
      parking: isTerreno ? null : toIntOrNull(val("parking")),
      built: isTerreno ? null : val("built") || null,
      land: val("land") || null,
      year: val("year") || null,
      image: val("image"),
      gallery: linesToArray(
        (document.getElementById("gallery") as HTMLTextAreaElement).value,
      ),
      description: linesToArray(
        (document.getElementById("description") as HTMLTextAreaElement).value,
      ),
      specs: specsToArray(
        (document.getElementById("specs") as HTMLTextAreaElement).value,
      ),
    };

    const { error } = await supabase
      .from("properties")
      .update(payload)
      .eq("id", propertyId);

    if (error) {
      if (errorEl) {
        errorEl.textContent = "No se pudo guardar: " + error.message;
        errorEl.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Guardar cambios";
      }
      return;
    }
    window.location.href = "/admin";
  });

  deleteBtn?.addEventListener("click", async () => {
    const ok =
      (await window.confirmModal?.(
        "¿Eliminar esta propiedad? Esta acción no se puede deshacer.",
      )) ??
      window.confirm(
        "¿Eliminar esta propiedad? Esta acción no se puede deshacer.",
      );
    if (!ok) return;
    const { error } = await supabase
      .from("properties")
      .delete()
      .eq("id", propertyId);

    if (error) {
      alert("No se pudo eliminar: " + error.message);
      return;
    }
    window.location.href = "/admin";
  });
</script>
