---
import '../styles/global.css';
import { site } from '../data/site.js';

interface Props {
  title: string;
  active?: string; // 'dashboard' | 'nueva'
  showSidebar?: boolean;
}
const { title, active = '', showSidebar = true } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Panel administrador</title>
</head>
<body class="min-h-screen bg-stone-50 font-body text-ink antialiased">
  {showSidebar ? (
    <div class="flex min-h-screen">
      <!-- Sidebar (desktop) -->
      <aside class="hidden w-64 shrink-0 flex-col justify-between border-r border-stone-200 bg-navy-950 px-5 py-8 md:flex">
        <div>
          <div class="flex items-center gap-3 px-2">
            <img src="/logo.png" alt={site.name} class="h-10 w-10 rounded-sm object-contain" />
            <div>
              <p class="font-display text-sm font-semibold leading-tight text-paper">{site.shortName}</p>
              <p class="font-ui text-[10px] uppercase tracking-widest2 text-gold-light">Panel admin</p>
            </div>
          </div>
          <nav class="mt-10 flex flex-col gap-1">
            <a
              href="/admin"
              class={`flex items-center gap-3 rounded-sm px-3 py-2.5 font-ui text-sm font-medium transition-colors ${
                active === 'dashboard' ? 'bg-paper/10 text-paper' : 'text-paper/60 hover:bg-paper/5 hover:text-paper'
              }`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" />
              </svg>
              Mis propiedades
            </a>
            <a
              href="/admin/propiedad/nueva"
              class={`flex items-center gap-3 rounded-sm px-3 py-2.5 font-ui text-sm font-medium transition-colors ${
                active === 'nueva' ? 'bg-paper/10 text-paper' : 'text-paper/60 hover:bg-paper/5 hover:text-paper'
              }`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Agregar propiedad
            </a>
          </nav>
        </div>
        <div class="flex flex-col gap-3">
          <a href="/" target="_blank" class="flex items-center gap-2 px-3 font-ui text-xs text-paper/50 transition-colors hover:text-paper/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
            Ver sitio web
          </a>
          <button id="admin-logout-btn" class="flex items-center gap-2 rounded-sm border border-paper/15 px-3 py-2.5 font-ui text-xs font-semibold text-paper/80 transition-colors hover:border-paper/30 hover:text-paper">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
            </svg>
            Cerrar sesión
          </button>
        </div>
      </aside>

      <div class="flex flex-1 flex-col">
        <!-- Top bar (mobile) -->
        <header class="flex items-center justify-between border-b border-stone-200 bg-white px-5 py-4 md:hidden">
          <div class="flex items-center gap-2">
            <img src="/logo.png" alt={site.name} class="h-8 w-8 rounded-sm object-contain" />
            <span class="font-display text-sm font-semibold text-navy-900">Panel admin</span>
          </div>
          <div class="flex items-center gap-2">
            <a href="/admin/propiedad/nueva" class="rounded-sm bg-navy-800 px-3 py-2 font-ui text-xs font-semibold text-paper">+ Agregar</a>
            <button id="admin-logout-btn-mobile" class="rounded-sm border border-stone-200 px-3 py-2 font-ui text-xs font-semibold text-navy-800">Salir</button>
          </div>
        </header>
        <main class="flex-1 px-5 py-8 md:px-10 md:py-10">
          <slot />
        </main>
      </div>
    </div>
  ) : (
    <main class="flex min-h-screen items-center justify-center bg-navy-950 px-5">
      <slot />
    </main>
  )}

  <script>
    import { supabase } from '../lib/supabase.js';
    async function doLogout() {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
    }
    document.getElementById('admin-logout-btn')?.addEventListener('click', doLogout);
    document.getElementById('admin-logout-btn-mobile')?.addEventListener('click', doLogout);
    
  </script>

  <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy-950/60 p-5">
  <div class="w-full max-w-sm rounded-sm bg-white p-6 shadow-cardLg">
    <p id="confirm-modal-title" class="font-display text-lg font-semibold text-navy-900">
      ¿Eliminar esta propiedad?
    </p>
    <p id="confirm-modal-text" class="mt-2 font-body text-sm text-stone-600">
      Esta acción no se puede deshacer.
    </p>
    <div class="mt-6 flex gap-3">
      <button id="confirm-modal-cancel" class="flex-1 rounded-sm border border-stone-200 py-2.5 font-ui text-sm font-semibold text-stone-600 hover:bg-stone-50">
        Cancelar
      </button>
      <button id="confirm-modal-accept" class="flex-1 rounded-sm bg-red-600 py-2.5 font-ui text-sm font-semibold text-paper hover:bg-red-700">
        Eliminar
      </button>
    </div>
  </div>
</div>
<script>
  // Declarar la propiedad custom en el objeto global Window
  declare global {
    interface Window {
      confirmModal?: (text?: string) => Promise<boolean>;
    }
  }

  function setupConfirmModal() {
    const modal = document.getElementById("confirm-modal") as HTMLDivElement | null;
    const textEl = document.getElementById("confirm-modal-text") as HTMLParagraphElement | null;
    const acceptBtn = document.getElementById("confirm-modal-accept") as HTMLButtonElement | null;
    const cancelBtn = document.getElementById("confirm-modal-cancel") as HTMLButtonElement | null;

    window.confirmModal = (text?: string): Promise<boolean> =>
      new Promise<boolean>((resolve) => {
        if (textEl) {
          textEl.textContent = text || "Esta acción no se puede deshacer.";
        }
        
        modal?.classList.remove("hidden");
        modal?.classList.add("flex");

        const cleanup = (result: boolean) => {
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
          acceptBtn?.removeEventListener("click", onAccept);
          cancelBtn?.removeEventListener("click", onCancel);
          resolve(result);
        };

        const onAccept = () => cleanup(true);
        const onCancel = () => cleanup(false);

        acceptBtn?.addEventListener("click", onAccept);
        cancelBtn?.addEventListener("click", onCancel);
      });
  }

  setupConfirmModal();
</script>
</body>
</html>